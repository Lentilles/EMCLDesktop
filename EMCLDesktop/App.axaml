<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:EMCLDesktop"
             x:Class="EMCLDesktop.App"
             Name="EMCL Desktop"
             RequestedThemeVariant="Dark">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="О программе EMCL Desktop…" Click="AboutMenuItemClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Параметры подключения…" Gesture="Meta+OemComma"
                            Click="ConnectionSettingsMenuItemClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <SolidColorBrush x:Key="WorkspaceNavigationBackground" Color="#1C2B41" />
        <SolidColorBrush x:Key="WorkspaceSidebarBackground" Color="#142033" />
        <SolidColorBrush x:Key="WorkspaceContentBackground" Color="#0D1726" />
        <SolidColorBrush x:Key="WorkspaceDividerBrush" Color="#31435B" />
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
