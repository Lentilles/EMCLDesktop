<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EMCLDesktop.Views.AboutContent">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/CommonStyles.axaml" />
    </UserControl.Styles>
    <Border Background="#0D1726" Padding="28" CornerRadius="8"
            BorderBrush="#31435B" BorderThickness="1">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                    <Image Source="/Assets/emcl-desktop.png" Width="72" Height="72" />
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="EMCL Desktop" FontSize="28" FontWeight="SemiBold"
                                   Foreground="#F4F7FC" TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText" Foreground="#69C4E1" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Чтение счётчиков DLMS/COSEM, просмотр объектов и профилей, анализ пакетов и трассировка обмена."
                           Classes="muted" TextWrapping="Wrap" />
                <TextBlock x:Name="UpdateStatusText" Classes="muted" TextWrapping="Wrap" />
                <StackPanel Spacing="4">
                    <TextBlock Text="© 2026 Alexey Tyapkin" Classes="muted" FontSize="12" />
                    <TextBlock Text="Лицензия MIT" Classes="muted" FontSize="12" />
                </StackPanel>
                <Button x:Name="CloseButton" Content="Закрыть" Classes="primary" IsDefault="True" IsCancel="True"
                        HorizontalAlignment="Right" Click="CloseClick" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
