<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EMCLDesktop.ViewModels"
             x:Class="EMCLDesktop.Views.ConnectionSettingsView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/CommonStyles.axaml" />
        <Style Selector="Border.settings-section">
            <Setter Property="Background" Value="{StaticResource WorkspaceContentBackground}" />
            <Setter Property="BorderBrush" Value="#293A52" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="ToggleButton.hdlc-link">
            <Setter Property="Width" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#22344C" />
            <Setter Property="BorderBrush" Value="#31435B" />
            <Setter Property="Foreground" Value="#ACBED3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.hdlc-link:checked">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#2C81A5" />
            <Setter Property="Foreground" Value="#69D9F4" />
        </Style>
        <Style Selector="ToggleButton.hdlc-link:checked /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.hdlc-link:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#2C81A5" />
        </Style>
        <Style Selector="ToggleButton.hdlc-link Path">
            <Setter Property="Stroke" Value="{Binding $parent[ToggleButton].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.8" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Background="{StaticResource WorkspaceContentBackground}">
        <StackPanel Spacing="0" HorizontalAlignment="Stretch">
            <StackPanel>
                <Border x:Name="ConnectionSection" Classes="settings-section">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Подключение" Classes="section-title" />
                            <TextBlock Text="Адрес прибора и параметры транспорта" Classes="muted" FontSize="12" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Тип подключения" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="12" IsVisible="{Binding IsTcp}">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="IP / хост" Classes="field-label" />
                                <TextBox Text="{Binding Host}" PlaceholderText="IP или имя хоста" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="TCP-порт" Classes="field-label" />
                                <TextBox Text="{Binding TcpPort}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="12" IsVisible="{Binding IsSerial}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Serial-порт" Classes="field-label" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding SerialPortNames}" SelectedItem="{Binding SerialPortName}"
                                              PlaceholderText="Выберите порт" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshSerialPortsCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding SerialPortsStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="5">
                                    <TextBlock Text="BaudRate, бит/с" Classes="field-label" />
                                    <TextBox Text="{Binding SerialBaudRate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="DataBits" Classes="field-label" />
                                    <ComboBox ItemsSource="{Binding SerialDataBitsOptions}" SelectedItem="{Binding SerialDataBits}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Parity" Classes="field-label" />
                                    <ComboBox ItemsSource="{Binding SerialParities}" SelectedItem="{Binding SerialParity}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="StopBits" Classes="field-label" />
                                    <ComboBox ItemsSource="{Binding SerialStopBitsOptions}" SelectedItem="{Binding SerialStopBits}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Handshake" Classes="field-label" />
                                <ComboBox ItemsSource="{Binding SerialHandshakes}" SelectedItem="{Binding SerialHandshake}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <WrapPanel>
                                <CheckBox Content="DTR" IsChecked="{Binding SerialDtrEnable}" Margin="0,0,20,0" />
                                <CheckBox Content="RTS" IsChecked="{Binding SerialRtsEnable}"
                                          IsEnabled="{Binding CanSetSerialRts}"
                                          ToolTip.Tip="При аппаратном Handshake линия RTS управляется автоматически." />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Кадрирование" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding Framings}" SelectedItem="{Binding Framing}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="AddressSection" Classes="settings-section">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Адресация" Classes="section-title" />
                            <TextBlock Text="Адреса клиента и сервера для выбранного транспорта"
                                       Classes="muted" FontSize="12" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="Клиент / Wrapper source" Classes="field-label" />
                                <TextBox Text="{Binding ClientAddress}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="Сервер / Wrapper destination" Classes="field-label" />
                                <TextBox Text="{Binding ServerAddress}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="10" IsVisible="{Binding IsHdlc}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Физический адрес HDLC" Classes="field-label" />
                                <TextBox Text="{Binding ServerPhysicalAddress}" />
                            </StackPanel>
                            <CheckBox Content="Расширенный HDLC-адрес"
                                      IsChecked="{Binding ExtendedHdlcAddress}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="AssociationSection" Classes="settings-section">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Ассоциация и доступ" Classes="section-title" />
                        <TextBlock Text="Укажите ассоциацию и способ аутентификации"
                                   Classes="muted" FontSize="12" />
                    </StackPanel>
                    <Grid ColumnDefinitions="150,*,190" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Версия Association LN" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding AssociationVersions}"
                                      SelectedItem="{Binding AssociationVersion}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="OBIS ассоциации" Classes="field-label" />
                            <TextBox Text="{Binding AssociationObis}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="Аутентификация" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding Authentications}"
                                      SelectedItem="{Binding Authentication}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,190" ColumnSpacing="12" IsVisible="{Binding HasPassword}">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Пароль или имя переменной окружения" Classes="field-label" />
                            <TextBox Text="{Binding Password}" PasswordChar="●" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Формат" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding PasswordFormats}"
                                      SelectedItem="{Binding PasswordFormat}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="ExchangeSection" Classes="settings-section">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Параметры обмена" Classes="section-title" />
                        <TextBlock Text="Ограничения соединения и возможности клиента"
                                   Classes="muted" FontSize="12" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Открытие соединения, с" Classes="field-label" />
                            <TextBox Text="{Binding ConnectTimeoutSeconds}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Без обмена, с" Classes="field-label" />
                            <TextBox Text="{Binding IdleTimeoutSeconds}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="Максимальный PDU" Classes="field-label" />
                            <TextBox Text="{Binding MaxReceivePduSize}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel IsVisible="{Binding IsHdlc}" Spacing="8">
                        <CheckBox x:Name="HdlcSizesToggle" Content="Согласовывать MAX TX / MAX RX"
                                  IsChecked="{Binding UseHdlcLinkParameters, Mode=TwoWay}" />
                        <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="5"
                              IsEnabled="{Binding UseHdlcLinkParameters}">
                            <TextBlock Text="MAX TX, байт" Classes="field-label" />
                            <TextBox x:Name="HdlcMaxTxInput" Grid.Row="1" Text="{Binding HdlcMaxTxBytes, Mode=TwoWay}"
                                     AutomationProperties.Name="HDLC MAX TX, байт" />
                            <ToggleButton x:Name="HdlcSizesLinkToggle" Grid.Column="1" Grid.Row="1" Classes="hdlc-link"
                                          IsChecked="{Binding AreHdlcSizesLinked, Mode=TwoWay}"
                                          ToolTip.Tip="{Binding HdlcSizesLinkActionText}"
                                          AutomationProperties.Name="{Binding HdlcSizesLinkActionText}">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 10,13 A 5,5 0 0 0 17.54,13.54 L 20.54,10.54 A 5,5 0 0 0 13.47,3.47 L 11.75,5.18 M 14,11 A 5,5 0 0 0 6.46,10.46 L 3.46,13.46 A 5,5 0 0 0 10.53,20.53 L 12.24,18.82" />
                                        <Path IsVisible="{Binding !AreHdlcSizesLinked}" Data="M 3,3 L 21,21" />
                                    </Canvas>
                                </Viewbox>
                            </ToggleButton>
                            <TextBlock Grid.Column="2" Text="MAX RX, байт" Classes="field-label" />
                            <TextBox x:Name="HdlcMaxRxInput" Grid.Column="2" Grid.Row="1" Text="{Binding HdlcMaxRxBytes, Mode=TwoWay}"
                                     AutomationProperties.Name="HDLC MAX RX, байт" />
                        </Grid>
                        <TextBlock Text="TX — отправка из приложения, RX — приём. От 3 до 2030 байт, включая LLC. Окна TX/RX — по 1 кадру."
                                   Classes="muted" FontSize="12" />
                        <TextBlock Text="Связанные поля меняются вместе. При включении связи RX принимает значение TX."
                                   Classes="muted" FontSize="12" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsHdlc}">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Повторы неподтверждённых кадров HDLC"
                                       Classes="field-label" TextWrapping="Wrap" />
                            <ComboBox ItemsSource="{Binding HdlcRetryCounts}"
                                      SelectedItem="{Binding HdlcInformationFrameRetryCount}"
                                      ToolTip.Tip="0 отключает повторы. При 1 приложение проверяет подтверждение через RR."
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Таймаут подтверждения HDLC, с"
                                       Classes="field-label" TextWrapping="Wrap" />
                            <TextBox Text="{Binding HdlcAcknowledgementTimeoutSeconds}"
                                     ToolTip.Tip="При включённом повторе таймаут «Без обмена» должен быть больше трёх таймаутов подтверждения." />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                        <TextBlock Text="KeepAlive каждые, с" Classes="field-label" />
                        <TextBox Text="{Binding KeepAliveIntervalSeconds}" Width="140"
                                 HorizontalAlignment="Left" />
                        <TextBlock Text="Во время простоя приложение коротко опрашивает Association LN. Чтение объектов не прерывается."
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="7">
                        <TextBlock Text="Conformance" Classes="field-label" />
                        <Button x:Name="ConformanceToggle" Classes="secondary" Content="Выбрать / отменить все" Click="ToggleConformanceClick" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding ConformanceOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConformanceOptionViewModel">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                              Margin="0,0,18,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <CheckBox Content="Пропускать одинаковые записи object_list"
                              IsChecked="{Binding IgnoreIdenticalObjectListEntries}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
