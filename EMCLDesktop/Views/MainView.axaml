<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:vm="using:EMCLDesktop.ViewModels"
             xmlns:views="using:EMCLDesktop.Views"
             x:Class="EMCLDesktop.Views.MainView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/CommonStyles.axaml" />
        <Style Selector="ToggleButton.regex-toggle">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#ACBED3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontFamily" Value="monospace" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.regex-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#273B53" />
        </Style>
        <Style Selector="ToggleButton.regex-toggle:checked">
            <Setter Property="Foreground" Value="#69C4E1" />
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#2C81A5" />
        </Style>
        <Style Selector="ToggleButton.regex-toggle:checked /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.regex-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#2C81A5" />
        </Style>
        <Style Selector="Button.connection-action">
            <Setter Property="Background" Value="#0C9BC4" />
            <Setter Property="BorderBrush" Value="#69D9F4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.connection-action.connected">
            <Setter Property="Background" Value="#D34853" />
            <Setter Property="BorderBrush" Value="#FF8B94" />
        </Style>
        <Style Selector="Button.connection-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#18AFD8" />
            <Setter Property="BorderBrush" Value="#A5E8FA" />
        </Style>
        <Style Selector="Button.connection-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#087FA3" />
            <Setter Property="BorderBrush" Value="#69D9F4" />
        </Style>
        <Style Selector="Button.connection-action.connected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E65863" />
            <Setter Property="BorderBrush" Value="#FFB3B9" />
        </Style>
        <Style Selector="Button.connection-action.connected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B83743" />
            <Setter Property="BorderBrush" Value="#FF8B94" />
        </Style>
        <Style Selector="Button.connection-action:disabled">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.object-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="22,3" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.object-row /template/ ContentPresenter#PART_ContentPresenter,
                         Button.object-row:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.object-row:pointerover">
            <Setter Property="Foreground" Value="#A5E8FA" />
        </Style>
        <Style Selector="Button.object-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#273B53" />
        </Style>
        <Style Selector="Button.object-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#214A61" />
        </Style>
        <Style Selector="Button.object-row.selected">
            <Setter Property="Foreground" Value="#69C4E1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Expander.object-group">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Expander.object-group /template/ Border#ExpanderContent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.object-group /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Grid.member-row > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.member-action">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Button.value-summary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#69C4E1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.settings-navigation">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ACBED3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.settings-navigation:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#273B53" />
            <Setter Property="Foreground" Value="#F4F7FC" />
        </Style>
        <Style Selector="Button.settings-navigation:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#214A61" />
        </Style>
        <Style Selector="Button.navigation">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ACBED3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.navigation:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#273B53" />
        </Style>
        <Style Selector="Button.navigation.selected">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
            <Setter Property="Foreground" Value="#A5E8FA" />
        </Style>
        <Style Selector="Button.navigation.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="Button.sidebar-icon Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.trace-output:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource WorkspaceContentBackground}" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
    </UserControl.Styles>

    <Grid>
    <Grid x:Name="Workspace" ColumnDefinitions="56,*" RowDefinitions="*,Auto" Background="{StaticResource WorkspaceContentBackground}">
        <Border Grid.RowSpan="2" Background="{StaticResource WorkspaceNavigationBackground}" BorderBrush="{StaticResource WorkspaceDividerBrush}" BorderThickness="0,0,1,0" Padding="7,8,8,12">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="4">
                    <Button Classes="navigation sidebar-icon" Classes.selected="{Binding IsObjectsTab}" Tag="0" Click="NavigateClick"
                            ToolTip.Tip="Объекты" ToolTip.Placement="Right" AutomationProperties.Name="Объекты">
                        <Path Data="M 1,1 H 9 V 9 H 1 Z M 15,1 H 23 V 9 H 15 Z M 1,15 H 9 V 23 H 1 Z M 15,15 H 23 V 23 H 15 Z" />
                    </Button>
                    <Button Classes="navigation sidebar-icon" Classes.selected="{Binding IsInspectorTab}" Tag="1" Click="NavigateClick"
                            ToolTip.Tip="Инспектор пакетов" ToolTip.Placement="Right" AutomationProperties.Name="Инспектор">
                        <Path Data="M 2,2 H 16 V 8 M 2,2 V 22 H 10 M 6,7 H 11 M 6,11 H 9 M 6,15 H 9 M 20,13 A 5,5 0 1 1 10,13 A 5,5 0 1 1 20,13 M 19,17 L 24,22" />
                    </Button>
                    <Button Classes="navigation sidebar-icon" Classes.selected="{Binding IsTraceTab}" Tag="2" Click="NavigateClick"
                            ToolTip.Tip="Трассировка" ToolTip.Placement="Right" AutomationProperties.Name="Трассировка">
                        <Path Data="M 1,13 H 6 L 10,3 L 14,23 L 18,13 H 24" />
                    </Button>
                    <Border Height="1" Background="#293A52" Margin="4,8" />
                    <Button Classes="navigation sidebar-icon" Classes.selected="{Binding IsConnectionSettingsTab}" Tag="3" Click="NavigateClick"
                            ToolTip.Tip="Параметры подключения" ToolTip.Placement="Right" AutomationProperties.Name="Параметры подключения">
                        <Path Data="M 1,5 H 6 M 10,5 H 23 M 1,12 H 14 M 18,12 H 23 M 1,19 H 4 M 8,19 H 23 M 6,2 H 10 V 8 H 6 Z M 14,9 H 18 V 15 H 14 Z M 4,16 H 8 V 22 H 4 Z" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="8">
                    <Button Classes="navigation sidebar-icon" IsVisible="{Binding IsOperationInProgress}"
                            Command="{Binding CancelOperationCommand}" ToolTip.Tip="{Binding CancelOperationText}"
                            ToolTip.Placement="Right" AutomationProperties.Name="{Binding CancelOperationText}">
                        <Path Data="M 4,4 L 20,20 M 20,4 L 4,20" />
                    </Button>
                    <Button Classes="connection-action sidebar-icon" Classes.connected="{Binding IsConnected}"
                            IsVisible="{Binding !IsConnecting}" Command="{Binding ToggleConnectionCommand}"
                            ToolTip.Tip="{Binding ConnectionActionText}" ToolTip.Placement="Right"
                            AutomationProperties.Name="{Binding ConnectionActionText}">
                        <Viewbox Width="20" Height="20">
                            <Path Width="24" Height="24" Stretch="None"
                                  Data="M 8,1 V 7 M 16,1 V 7 M 5,7 H 19 V 11 A 7,7 0 0 1 5,11 Z M 12,18 V 23" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid IsVisible="{Binding IsObjectsTab}" ColumnDefinitions="270,*">
                <Border Grid.Column="0" Classes="workspace-sidebar" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <StackPanel Grid.Row="0" Spacing="7" Margin="11,10,11,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Каталог OBIS" Classes="section-title" />
                                <TextBlock Grid.Column="1" Text="{Binding VisibleObjectCount}"
                                           Foreground="#69C4E1" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Button Content="Считать дерево" Classes="secondary member-action"
                                    Command="{Binding ReadTreeCommand}" HorizontalAlignment="Stretch" />
                            <TextBox x:Name="ObjectSearchBox" Text="{Binding SearchText}" PlaceholderText="OBIS, класс или ID">
                                <TextBox.InnerRightContent>
                                    <ToggleButton x:Name="RegexToggle" Content=".*" Classes="regex-toggle"
                                                  IsChecked="{Binding UseRegularExpression, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="Регулярное выражение"
                                                  AutomationProperties.Name="Регулярное выражение" />
                                </TextBox.InnerRightContent>
                            </TextBox>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6"
                                  IsEnabled="{Binding CanSelectObjects}">
                                <Button Content="Свернуть все" Classes="secondary member-action"
                                        Command="{Binding CollapseAllGroupsCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="Развернуть все" Classes="secondary member-action"
                                        Command="{Binding ExpandAllGroupsCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding SearchError}" Foreground="#FF9E9E"
                                       IsVisible="{Binding SearchError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Background="#293A52" />
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleGroups}"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding CanSelectObjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ObjectGroupViewModel">
                                        <Expander Classes="object-group" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  ToolTip.Tip="{Binding Subtitle}">
                                            <Expander.Header>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                                    <TextBlock Text="{Binding ClassName}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="muted"
                                                               FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Objects}" HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MeterObjectViewModel">
                                                        <Button Classes="object-row"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Click="SelectObjectClick">
                                                            <TextBlock Text="{Binding Obis}" FontSize="12" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="workspace-content" Padding="20,16">
                    <Grid>
                        <TextBlock Text="Выберите OBIS в каталоге." Classes="muted" Margin="0,24"
                                   HorizontalAlignment="Center" IsVisible="{Binding HasNoSelectedObject}" />
                        <ContentControl Content="{Binding SelectedObject}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:MeterObjectViewModel">
                                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Obis}" FontSize="24" FontWeight="SemiBold"
                                                       Foreground="#F4F7FC" Margin="0,0,14,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ClassName}" Foreground="#69C4E1"
                                                       Margin="0,0,14,0" VerticalAlignment="Center" />
                                            <TextBlock Classes="muted" FontSize="12"
                                                       Text="{Binding ClassId, StringFormat='Класс {0}'}"
                                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Classes="muted" FontSize="12"
                                                       Text="{Binding ClassVersion, StringFormat='Версия {0}'}"
                                                       VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <TabStrip Grid.Row="1" IsVisible="{Binding IsProfileGeneric}"
                                                  SelectedIndex="{Binding ProfileModeIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Режим Profile Generic">
                                            <TabStrip.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </TabStrip.ItemsPanel>
                                            <TabStripItem Content="Обычный режим" />
                                            <TabStripItem Content="Продвинутый режим" />
                                        </TabStrip>
                                        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" IsVisible="{Binding ShowObjectMembers}">
                                            <Button Classes="secondary member-action" Content="Считать все атрибуты"
                                                    Margin="0,0,8,4" Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).ReadSelectedObjectCommand}" />
                                            <Button Classes="primary member-action" Margin="0,0,0,4"
                                                    Content="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).WritePendingText}"
                                                    Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).WritePendingCommand}" />
                                        </WrapPanel>
                                        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                                            <Grid x:Name="MemberViewport">
                                                <StackPanel Spacing="12" IsVisible="{Binding ShowProfileRecords}">
                                                    <Border Classes="item" Padding="12">
                                                        <WrapPanel>
                                                            <StackPanel Spacing="5" Margin="0,0,12,8">
                                                                <TextBlock Text="Способ чтения" Classes="field-label" />
                                                                <ComboBox ItemsSource="{Binding ProfileReadModes}"
                                                                          SelectedItem="{Binding SelectedProfileReadMode}"
                                                                          IsEnabled="{Binding IsProfileReadEnabled}"
                                                                          HorizontalAlignment="Stretch" />
                                                            </StackPanel>
                                                            <StackPanel Spacing="5" Width="122" Margin="0,0,12,8" IsVisible="{Binding IsProfileCountMode}">
                                                                <TextBlock Text="Количество записей" Classes="field-label" />
                                                                <TextBox Text="{Binding ProfileCountText}"
                                                                         PlaceholderText="10" IsEnabled="{Binding IsProfileReadEnabled}" />
                                                            </StackPanel>
                                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Width="210" Margin="0,0,12,8"
                                                                  IsVisible="{Binding IsProfileEntryRangeMode}">
                                                                <StackPanel Grid.Column="0" Spacing="5">
                                                                    <TextBlock Text="С записи" Classes="field-label" />
                                                                    <TextBox Text="{Binding ProfileFirstEntryText}"
                                                                             PlaceholderText="1" IsEnabled="{Binding IsProfileReadEnabled}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="5">
                                                                    <TextBlock Text="По запись" Classes="field-label" />
                                                                    <TextBox Text="{Binding ProfileLastEntryText}"
                                                                             PlaceholderText="10" IsEnabled="{Binding IsProfileReadEnabled}" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <StackPanel Spacing="8" Margin="0,0,12,8" IsVisible="{Binding IsProfileDateRangeMode}">
                                                                <TextBlock Text="Столбец времени" Classes="field-label" />
                                                                <ComboBox ItemsSource="{Binding ProfileCaptureColumns}"
                                                                          SelectedItem="{Binding SelectedProfileCaptureColumn}"
                                                                          IsEnabled="{Binding IsProfileReadEnabled}"
                                                                          HorizontalAlignment="Stretch">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ProfileCaptureColumnViewModel">
                                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                                <TextBlock Text="Сначала считайте профиль, чтобы загрузить список столбцов."
                                                                           Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                                    <StackPanel Grid.Column="0" Spacing="5">
                                                                        <TextBlock Text="С даты" Classes="field-label" />
                                                                        <DatePicker SelectedDate="{Binding ProfileFromDate}"
                                                                                    IsEnabled="{Binding IsProfileReadEnabled}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Spacing="5">
                                                                        <TextBlock Text="По дату" Classes="field-label" />
                                                                        <DatePicker SelectedDate="{Binding ProfileToDate}"
                                                                                    IsEnabled="{Binding IsProfileReadEnabled}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel Spacing="5">
                                                                    <TextBlock Text="Часовой пояс счётчика" Classes="field-label" />
                                                                    <TextBox Text="{Binding ProfileTimeZone}" PlaceholderText="+03:00"
                                                                             IsEnabled="{Binding IsProfileReadEnabled}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button Content="Считать профиль" Classes="primary member-action" VerticalAlignment="Top" Margin="0,21,0,8" Click="ReadProfileClick"
                                                                    IsEnabled="{Binding IsProfileReadEnabled}" />
                                                        </WrapPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding ProfileTableStatus}" Classes="muted"
                                                               FontSize="12" />
                                                    <ContentControl Content="{Binding ProfileTable}">
                                                        <ContentControl.ContentTemplate>
                                                            <DataTemplate x:DataType="vm:ProfileTableViewModel">
                                                                <StackPanel Spacing="8">
                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                                    <TextBlock Grid.Column="0" Text="{Binding PageSummary}"
                                                                               Classes="muted" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Grid.Column="1" Content="Назад" Classes="secondary"
                                                                            IsEnabled="{Binding CanPreviousPage}"
                                                                            Click="ProfilePreviousPageClick" />
                                                                    <Button Grid.Column="2" Content="Далее" Classes="secondary"
                                                                            IsEnabled="{Binding CanNextPage}"
                                                                            Click="ProfileNextPageClick" />
                                                                </Grid>
                                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                              VerticalScrollBarVisibility="Disabled">
                                                                    <StackPanel Spacing="0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Border Width="50" MinHeight="66"
                                                                                    Background="#214A61" Padding="8"
                                                                                    BorderBrush="#31435B" BorderThickness="1">
                                                                                <TextBlock Text="№" FontWeight="Bold" />
                                                                            </Border>
                                                                            <ItemsControl ItemsSource="{Binding Columns}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:ProfileColumnViewModel">
                                                                                        <Border Width="220" MinHeight="66"
                                                                                                Background="#214A61" Padding="8"
                                                                                                BorderBrush="#31435B" BorderThickness="1">
                                                                                            <StackPanel Spacing="3">
                                                                                                <TextBlock Text="{Binding Obis}"
                                                                                                           FontWeight="SemiBold"
                                                                                                           TextWrapping="Wrap" />
                                                                                                <TextBlock Text="{Binding Name}"
                                                                                                           Classes="muted" FontSize="12"
                                                                                                           TextWrapping="Wrap" />
                                                                                                <ComboBox IsVisible="{Binding HasOctets}"
                                                                                                          ItemsSource="{Binding OctetFormats}"
                                                                                                          SelectedItem="{Binding OctetFormat, Mode=TwoWay}"
                                                                                                          HorizontalAlignment="Stretch"
                                                                                                          MaxDropDownHeight="320"
                                                                                                          AutomationProperties.Name="Кодировка столбца OctetString"
                                                                                                          ToolTip.Tip="Формат всех значений OctetString в столбце" />
                                                                                            </StackPanel>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:ProfileRowViewModel">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <Border Width="50" MinHeight="42" Padding="8"
                                                                                                Background="#172438"
                                                                                                BorderBrush="#31435B" BorderThickness="1">
                                                                                            <TextBlock Text="{Binding Number}"
                                                                                                       Classes="muted" />
                                                                                        </Border>
                                                                                        <ItemsControl ItemsSource="{Binding Cells}">
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <StackPanel Orientation="Horizontal" />
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate x:DataType="vm:ProfileCellViewModel">
                                                                                                    <Border Width="220" MinHeight="42"
                                                                                                            Padding="8" Background="#172438"
                                                                                                            BorderBrush="#31435B"
                                                                                                            BorderThickness="1">
                                                                                                        <StackPanel Spacing="2">
                                                                                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                                                                                            <TextBlock Text="{Binding NumericHexValue}" IsVisible="{Binding HasNumber}"
                                                                                                                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                                                                                        </StackPanel>
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </ScrollViewer>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ContentControl.ContentTemplate>
                                                    </ContentControl>
                                                </StackPanel>
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                              IsVisible="{Binding ShowObjectMembers}">
                                                    <StackPanel Spacing="9" MinWidth="600" Margin="0,0,0,12"
                                                                Width="{Binding #MemberViewport.Bounds.Width}">
                                                        <TextBlock Text="Атрибуты" Classes="section-title" />
                                                        <Border BorderBrush="#31435B" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                            <StackPanel>
                                                                <Border Background="#214A61">
                                                                    <Grid ColumnDefinitions="28,1.4*,*,*,1.4*,157" ColumnSpacing="8"
                                                                          Margin="9,7">
                                                                        <TextBlock Text="№" Classes="field-label" />
                                                                        <TextBlock Grid.Column="1" Text="Имя" Classes="field-label" />
                                                                        <TextBlock Grid.Column="2" Text="Тип" Classes="field-label" />
                                                                        <TextBlock Grid.Column="3" Text="Доступ" Classes="field-label" />
                                                                        <TextBlock Grid.Column="4" Text="Значение" Classes="field-label" />
                                                                        <TextBlock Grid.Column="5" Text="Действия" Classes="field-label" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                </Border>
                                                                <ItemsControl ItemsSource="{Binding Attributes}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:AttributeViewModel">
                                                                            <Border Background="#172438" BorderBrush="#31435B" BorderThickness="0,1,0,0" Padding="9,5">
                                                                                <Grid Classes="member-row" ColumnDefinitions="28,1.4*,*,*,1.4*,157" ColumnSpacing="8" MinHeight="30" TextElement.FontSize="12">
                                                                                    <TextBlock Text="{Binding Index}" Classes="muted" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                                                                                    <TextBlock Grid.Column="2" Text="{Binding Type}" />
                                                                                    <TextBlock Grid.Column="3" Text="{Binding Access}" />
                                                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                                                                                        <Button Classes="value-summary" Click="BrowseAttributeClick"
                                                                                                IsVisible="{Binding HasValueBrowser}"
                                                                                                ToolTip.Tip="Открыть значение">
                                                                                            <TextBlock Text="{Binding ValueSummary, StringFormat='{}{0} ↗'}"
                                                                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                                        </Button>
                                                                                        <Button Classes="value-summary" Click="BrowseAttributeClick"
                                                                                                IsVisible="{Binding HasScalarDetails}" ToolTip.Tip="Открыть значение">
                                                                                            <TextBlock Text="{Binding ValueSummary}" MaxLines="1"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                        </Button>
                                                                                        <SelectableTextBlock IsVisible="{Binding HasInlineInteger}" TextWrapping="Wrap">
                                                                                            <Run Text="{Binding ValueSummary}" />
                                                                                            <Run Text="{Binding InlineIntegerHex}" Foreground="#ACBED3" />
                                                                                        </SelectableTextBlock>
                                                                                        <TextBlock Text="{Binding ValueSummary}" IsVisible="{Binding HasPlainSummary}"
                                                                                                   ToolTip.Tip="{Binding ValueSummary}" MaxLines="1"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="К записи" IsVisible="{Binding HasPendingValue}" Foreground="#69C4E1" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                        <Button Classes="secondary member-action" Content="Изменить" Click="EditAttributeClick"
                                                                                                IsEnabled="{Binding IsWriteEnabled}" ToolTip.Tip="{Binding WriteUnavailableReason}"
                                                                                                ToolTip.ShowOnDisabled="True" />
                                                                                        <Button Classes="secondary member-action" Content="Считать" Click="ReadAttributeClick"
                                                                                                IsEnabled="{Binding IsReadEnabled}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Методы" Classes="section-title" Margin="0,8,0,0" />
                                                        <Border BorderBrush="#31435B" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                            <StackPanel>
                                                                <Border Background="#214A61">
                                                                    <Grid ColumnDefinitions="28,2*,*,*,100" ColumnSpacing="8" Margin="9,7">
                                                                        <TextBlock Text="№" Classes="field-label" />
                                                                        <TextBlock Grid.Column="1" Text="Имя" Classes="field-label" />
                                                                        <TextBlock Grid.Column="2" Text="Тип параметра" Classes="field-label" />
                                                                        <TextBlock Grid.Column="3" Text="Доступ" Classes="field-label" />
                                                                        <TextBlock Grid.Column="4" Text="Действия" Classes="field-label" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                </Border>
                                                                <ItemsControl ItemsSource="{Binding Methods}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:MethodViewModel">
                                                                            <Border Background="#172438" BorderBrush="#31435B" BorderThickness="0,1,0,0" Padding="9,5">
                                                                                <Grid Classes="member-row" RowDefinitions="Auto,Auto" ColumnDefinitions="28,2*,*,*,100" ColumnSpacing="8" MinHeight="30" TextElement.FontSize="12">
                                                                                    <TextBlock Text="{Binding Index}" Classes="muted" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                                                                                    <TextBlock Grid.Column="2" Text="{Binding ParameterType}" />
                                                                                    <TextBlock Grid.Column="3" Text="{Binding Access}" />
                                                                                    <Button Grid.Column="4" Classes="secondary member-action" Content="Вызвать"
                                                                                            Click="OpenMethodClick" IsEnabled="{Binding IsInvokeEnabled}"
                                                                                            ToolTip.Tip="{Binding InvokeUnavailableReason}" ToolTip.ShowOnDisabled="True"
                                                                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                                                                                         Text="{Binding InvokeStatus}" TextWrapping="Wrap" Foreground="#69C4E1"
                                                                                                         IsVisible="{Binding InvokeStatus, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </Border>
            </Grid>
            <Grid IsVisible="{Binding IsInspectorTab}">
                <views:PacketInspectorView DataContext="{Binding Inspector}" />
            </Grid>
            <Grid IsVisible="{Binding IsTraceTab}" ColumnDefinitions="300,*">
                <Border Classes="workspace-sidebar">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Трассировка" Classes="section-title" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Формат" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding TraceFormats}" HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding SelectedTraceFormatIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <Button Classes="secondary" Content="Копировать трассировку" Click="CopyTraceClick"
                                HorizontalAlignment="Stretch" />
                        <Button Classes="secondary" Content="Сохранить трассировку" Click="SaveTraceClick"
                                HorizontalAlignment="Stretch" />
                        <Button Classes="secondary" Content="Очистить лог" Command="{Binding ClearTraceCommand}"
                                HorizontalAlignment="Stretch" />
                        <TextBlock Classes="muted" FontSize="12"
                                   Text="Формат применяется к просмотру, копированию и сохранению." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="workspace-content" Padding="0">
                    <TextBox Classes="trace-output" Text="{Binding TraceText}" IsReadOnly="True"
                             Background="{StaticResource WorkspaceContentBackground}" BorderThickness="0" CornerRadius="0" Foreground="#E7EFF8"
                             AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" FontSize="12" Padding="16" />
                </Border>
            </Grid>
            <Grid IsVisible="{Binding IsConnectionSettingsTab}" ColumnDefinitions="300,*">
                <Border Classes="workspace-sidebar">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Параметры подключения" Classes="section-title" TextWrapping="Wrap" />
                        <TextBlock Text="Изменения применяются к следующему подключению." Classes="muted" FontSize="12" />
                        <StackPanel Spacing="4">
                            <Button Classes="settings-navigation" Content="Подключение" Tag="Connection" Click="SettingsNavigationClick" HorizontalAlignment="Stretch" />
                            <Button Classes="settings-navigation" Content="Адресация" Tag="Address" Click="SettingsNavigationClick" HorizontalAlignment="Stretch" />
                            <Button Classes="settings-navigation" Content="Ассоциация и доступ" Tag="Association" Click="SettingsNavigationClick" HorizontalAlignment="Stretch" />
                            <Button Classes="settings-navigation" Content="HighGMAC" Tag="HighGMAC" Click="SettingsNavigationClick" IsVisible="{Binding IsHighGmac}" HorizontalAlignment="Stretch" />
                            <Button Classes="settings-navigation" Content="Параметры обмена" Tag="Exchange" Click="SettingsNavigationClick" HorizontalAlignment="Stretch" />
                            <Button Classes="settings-navigation" Content="Продвинутые настройки" Tag="Advanced" Click="SettingsNavigationClick" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <Button Classes="secondary" Content="Загрузить конфигурацию" Click="LoadConfigurationClick"
                                HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditConfiguration}" />
                        <Button Classes="secondary" Content="Сохранить конфигурацию" Click="SaveConfigurationClick"
                                HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditConfiguration}" />
                    </StackPanel>
                </Border>
                <views:ConnectionSettingsView x:Name="ConnectionSettings" Grid.Column="1" IsEnabled="{Binding CanEditConfiguration}" />
            </Grid>
        </Grid>
        <Border Grid.Column="1" Grid.Row="1" Padding="16,6" Background="{StaticResource WorkspaceContentBackground}"
                BorderBrush="{StaticResource WorkspaceDividerBrush}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#ACBED3" FontSize="11" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="secondary" Content="Копировать" IsVisible="{Binding HasStatusError}"
                        ToolTip.Tip="Копировать текст ошибки" Padding="8,3" FontSize="11" VerticalAlignment="Center" Click="CopyStatusClick" />
                <Button Grid.Column="2" Click="AboutClick" Width="12" Height="12" MinWidth="0" MinHeight="0"
                        Padding="0" BorderThickness="0" Background="Transparent" Foreground="#ACBED3"
                        VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="О приложении" ToolTip.Placement="Top" AutomationProperties.Name="О приложении">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1.8" Data="M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 M 12,10 V 17 M 12,6 V 7" />
                </Button>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="5" Margin="0,8,0,0"
                            IsVisible="{Binding IsTreeReadInProgress}">
                    <TextBlock Text="{Binding TreeReadProgressText}" Foreground="#69C4E1" FontSize="12" />
                    <ProgressBar Minimum="0" Maximum="{Binding TreeReadProgressMaximum}" Value="{Binding TreeReadCurrent}"
                                 IsIndeterminate="{Binding IsTreeReadIndeterminate}" Height="6" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="5" Margin="0,8,0,0"
                            IsVisible="{Binding IsProfileReadInProgress}">
                    <TextBlock Text="{Binding ProfileReadProgressText}" Foreground="#69C4E1" FontSize="12" />
                    <ProgressBar Minimum="0" Maximum="{Binding ProfileReadProgressMaximum}"
                                 Value="{Binding ProfileReadProgressCurrent}"
                                 IsIndeterminate="{Binding IsProfileReadIndeterminate}" Height="6" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
        <Border x:Name="DialogOverlay" IsVisible="False" Background="#B8000710"
                Padding="16" KeyDown="DialogKeyDown" KeyboardNavigation.TabNavigation="Cycle">
            <ContentControl x:Name="ObjectDialog" HorizontalAlignment="Center" VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</UserControl>
