<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EMCLDesktop.ViewModels"
        xmlns:views="using:EMCLDesktop.Views"
        x:Class="EMCLDesktop.Views.ConnectionSettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="Параметры подключения"
        Background="#0D1726" Width="1040" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Styles>
        <StyleInclude Source="/Styles/CommonStyles.axaml" />
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="24">
        <StackPanel Spacing="5">
            <TextBlock Text="Параметры подключения" FontSize="24" FontWeight="SemiBold"
                       Foreground="#F4F7FC" />
            <TextBlock Text="Изменения применяются к следующему подключению." Classes="muted" />
        </StackPanel>
        <views:ConnectionSettingsView Grid.Row="1" IsEnabled="{Binding CanEditConfiguration}" />
        <Button Grid.Row="2" Classes="primary" Content="Готово" IsCancel="True"
                HorizontalAlignment="Right" Click="CloseClick" />
    </Grid>
</Window>
