<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EMCLDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:EMCLDesktop.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="EMCLDesktop.Views.MainWindow"
        Icon="/Assets/emcl-desktop.ico"
        Title="EMCL Desktop — счётчик DLMS/COSEM"
        Background="{StaticResource WorkspaceContentBackground}"
        Width="1320" Height="840" MinWidth="1000" MinHeight="680">
    <Grid RowDefinitions="Auto,*">
        <Border x:Name="UpdateNotice" IsVisible="False" Background="#183C50"
                Padding="16,10" BorderBrush="#39738B" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                <TextBlock Text="Новая версия загружена. Приложение перезапустится для установки обновления."
                           Foreground="#F4F7FC" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="ApplyUpdateButton" Grid.Column="1" IsEnabled="{ReflectionBinding CanEditConfiguration}" Content="Обновить" Click="ApplyUpdateClick"
                        VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="✕" Click="DismissUpdateNoticeClick"
                        ToolTip.Tip="Скрыть уведомление" AutomationProperties.Name="Скрыть уведомление"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
        <views:MainView x:Name="MainContent" Grid.Row="1" />
    </Grid>
</Window>
