<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EMCLDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:EMCLDesktop.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="EMCLDesktop.Views.MainWindow"
        Icon="/Assets/emcl-desktop.ico"
        Title="EMCL Desktop — счётчик DLMS/COSEM"
        Background="{StaticResource WorkspaceContentBackground}"
        Width="1320" Height="840" MinWidth="1000" MinHeight="680">
    <views:MainView />
</Window>
