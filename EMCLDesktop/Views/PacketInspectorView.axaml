<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EMCLDesktop.ViewModels"
             xmlns:views="using:EMCLDesktop.Views"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="EMCLDesktop.Views.PacketInspectorView"
             x:DataType="vm:PacketInspectorViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/CommonStyles.axaml" />
        <Style Selector="Button.source.selected">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="Expander.analysis-input">
            <Setter Property="Background" Value="{StaticResource WorkspaceSidebarBackground}" />
            <Setter Property="BorderBrush" Value="#293A52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.analysis-input /template/ Border#ExpanderContent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Expander.analysis-input /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.analysis-log:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource WorkspaceSidebarBackground}" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="TextBox.analysis-log:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="ToggleButton.packet-autoscroll">
            <Setter Property="Background" Value="#22344C" />
            <Setter Property="Foreground" Value="#ACBED3" />
            <Setter Property="BorderBrush" Value="#31435B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.packet-autoscroll:checked">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="Foreground" Value="#A5E8FA" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="ToggleButton.packet-autoscroll:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="Button.scroll-to-top">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F4F7FC" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.scroll-to-top:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2C6480" />
        </Style>
        <Style Selector="Border.field">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.field.highlighted">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="Border.field.error">
            <Setter Property="Background" Value="#622C36" />
            <Setter Property="BorderBrush" Value="#F48888" />
        </Style>
        <Style Selector="Border.field.error.highlighted">
            <Setter Property="Background" Value="#503469" />
            <Setter Property="BorderBrush" Value="#CA9DF0" />
        </Style>
        <Style Selector="TreeViewItem" x:DataType="vm:InspectorFieldViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.hex-byte">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="monospace" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.hex-byte.highlighted">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
            <Setter Property="Foreground" Value="#A5E8FA" />
        </Style>
        <Style Selector="Button.hex-byte.error">
            <Setter Property="Background" Value="#622C36" />
            <Setter Property="BorderBrush" Value="#F48888" />
            <Setter Property="Foreground" Value="#FFCCC8" />
        </Style>
        <Style Selector="Button.hex-byte.error.highlighted">
            <Setter Property="Background" Value="#503469" />
            <Setter Property="BorderBrush" Value="#CA9DF0" />
            <Setter Property="Foreground" Value="#F0D9FF" />
        </Style>
        <Style Selector="Border.assembled-packet">
            <Setter Property="Background" Value="#244A366B" />
            <Setter Property="BorderBrush" Value="#CA9DF0" />
        </Style>
        <Style Selector="Border.assembled-packet TextBlock.packet-summary">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.assembled-packet TextBlock.packet-summary:not(.packet-error)">
            <Setter Property="Foreground" Value="#E2CAFF" />
        </Style>
        <Style Selector="TextBlock.packet-error">
            <Setter Property="Foreground" Value="#FFB4A9" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="300,Auto,1.1*,Auto,1.5*">
        <Border Classes="workspace-sidebar" BorderThickness="0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
                <TextBlock Text="Пакеты" Classes="section-title" FontSize="16" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Button Content="Подключение" Classes="secondary source" FontSize="11" Padding="8,7"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Анализировать текущее подключение"
                            Classes.selected="{Binding IsLive}" Command="{Binding LiveSourceCommand}" />
                    <Button Grid.Column="1" Content="Текст" Classes="secondary source" FontSize="11" Padding="12,7"
                            ToolTip.Tip="Анализировать текст"
                            Classes.selected="{Binding IsText}" Command="{Binding TextSourceCommand}" />
                </Grid>
                <Grid Grid.Row="2" IsVisible="{Binding IsText}" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Expander Classes="analysis-input" Header="Текст для анализа" FontSize="12"
                              IsExpanded="{Binding IsInputExpanded, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBox Classes="analysis-log" Text="{Binding InputText, Mode=TwoWay}" Margin="0" Padding="8"
                                 Background="{StaticResource WorkspaceContentBackground}" BorderBrush="#536F8B" BorderThickness="1" CornerRadius="0" Foreground="#E7EFF8"
                                 AcceptsReturn="True" MinHeight="90" MaxHeight="140" FontFamily="monospace" FontSize="11"
                                 TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="Вставьте лог HDLC / Wrapper / DLMS APDU" />
                    </Expander>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Разобрать" Classes="primary" Command="{Binding AnalyzeTextCommand}" Padding="12,7" FontSize="12" />
                        <Button Content="Отменить" Classes="secondary" IsVisible="{Binding IsAnalyzing}" Padding="12,7" FontSize="12"
                                Command="{Binding AnalyzeTextCancelCommand}" AutomationProperties.Name="Отменить разбор лога" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Classes="muted" FontSize="11"
                               Text="Разбор выполняется локально. Текст и выбранный пакет сохраняются при смене режима." />
                </Grid>
                <StackPanel Grid.Row="3" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <TextBlock Text="Пакетов в списке" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding PacketLimitOptions}" SelectedItem="{Binding PacketLimit}"
                                  Width="70" MinWidth="0" Padding="4,5" FontSize="11"
                                  ToolTip.Tip="В инспекторе остаются последние пакеты. При увеличении лимита ранее удалённые записи не восстанавливаются. Полная трассировка доступна до очистки."
                                  AutomationProperties.Name="Максимум пакетов в списке" />
                        <ToggleButton x:Name="AutoScrollToggle" Grid.Column="2" Classes="packet-autoscroll"
                                      Content="↓ Автопрокрутка" Click="AutoScrollClick" Padding="4,5" FontSize="10"
                                      ToolTip.Tip="Следить за последним пакетом" AutomationProperties.Name="Автопрокрутка к последнему пакету" />
                    </Grid>
                    <TextBlock Text="{Binding AnalysisStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding AnalysisStatus, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <Grid Grid.Row="4">
                    <ListBox x:Name="PacketList" SelectionMode="Multiple"
                             Background="Transparent" BorderThickness="0" MinHeight="80"
                             ToolTip.Tip="Выберите первый пакет, затем нажмите на последний с Shift."
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                            <Style Selector="SelectableTextBlock.muted">
                                <Setter Property="Foreground" Value="#ACBED3" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PacketItemViewModel">
                                <Grid ColumnDefinitions="Auto,*">
                                    <views:PacketAssemblyGutter PacketId="{Binding Packet.Id}" IsHitTestVisible="False"
                                        AssemblyLayout="{Binding $parent[views:PacketInspectorView].((vm:PacketInspectorViewModel)DataContext).AssemblyLayout}" />
                                    <Border Grid.Column="1" Classes.assembled-packet="{Binding IsAssembled}"
                                            BorderThickness="3,0,0,0" Padding="5,4" Margin="0,10,10,10">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Summary}" Classes="packet-summary" TextWrapping="Wrap" FontSize="12"
                                                       Classes.packet-error="{Binding HasError}" />
                                            <TextBlock Text="{Binding Details}" Classes="muted" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" Margin="0,0,0,10">
                        <Button x:Name="ScrollToFirstButton" Classes="scroll-to-top" Content="↑" IsVisible="False"
                                Click="ScrollToFirstClick" PointerEntered="ScrollButtonPointerEntered"
                                PointerExited="ScrollButtonPointerExited" ToolTip.Tip="К первому пакету в списке"
                                AutomationProperties.Name="Перейти к первому пакету" />
                        <Button x:Name="ScrollToLastButton" Classes="scroll-to-top" Content="↓" IsVisible="False"
                                Click="ScrollToLastClick" PointerEntered="ScrollButtonPointerEntered"
                                PointerExited="ScrollButtonPointerExited" ToolTip.Tip="К последнему пакету в списке"
                                AutomationProperties.Name="Перейти к последнему пакету" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Classes="workspace-divider" ResizeDirection="Columns" />
        <Border Grid.Column="2" Classes="workspace-content">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Структура пакета" Classes="section-title" FontSize="16" />
                <TreeView x:Name="InspectorFieldsTree" Grid.Row="1" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0" MinHeight="100"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="vm:InspectorFieldViewModel" ItemsSource="{Binding Children}">
                            <Border Classes="field" Classes.highlighted="{Binding IsHighlighted}" Classes.error="{Binding IsError}"
                                    PointerEntered="FieldPointerEntered" PointerExited="FieldPointerExited">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" />
                            </Border>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="3" Classes="workspace-divider" ResizeDirection="Columns" />
        <Border Grid.Column="4" Classes="workspace-content">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding PacketTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PacketOrigin}" Classes="muted" FontSize="11"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding BytePageText}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="secondary" Content="←" Command="{Binding PreviousBytePageCommand}" IsEnabled="{Binding CanPreviousPage}"
                            ToolTip.Tip="Предыдущие 256 байт" Padding="10,4" />
                    <Button Grid.Column="2" Classes="secondary" Content="→" Command="{Binding NextBytePageCommand}" IsEnabled="{Binding CanNextPage}"
                            ToolTip.Tip="Следующие 256 байт" Padding="10,4" />
                </Grid>
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="8" SizeChanged="PacketContentSizeChanged">
                    <ScrollViewer x:Name="PacketBytesScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
                        <ItemsControl ItemsSource="{Binding ByteRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InspectorByteRow">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Offset}" FontFamily="monospace" FontSize="12" Foreground="#ACBED3"
                                                   VerticalAlignment="Center" Width="52" />
                                        <ItemsControl ItemsSource="{Binding Bytes}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InspectorByteViewModel">
                                                    <Button Content="{Binding Hex}" Classes="hex-byte" Classes.highlighted="{Binding IsHighlighted}"
                                                            Classes.error="{Binding IsError}"
                                                            ToolTip.Tip="{Binding Description}" AutomationProperties.Name="{Binding Description}"
                                                            PointerEntered="BytePointerEntered" PointerExited="BytePointerExited"
                                                            GotFocus="ByteGotFocus" LostFocus="ByteLostFocus" Click="ByteClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" IsVisible="{Binding HasPacket}" Text="{Binding ByteHighlightText}"
                               ToolTip.Tip="{Binding ByteHighlightText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Classes="muted" FontSize="11" />
                    <Border Grid.Row="2" IsVisible="{Binding HasFieldPreview}"
                            BorderBrush="{StaticResource WorkspaceDividerBrush}" BorderThickness="0,1,0,0" Padding="0,5,0,0">
                        <ListBox x:Name="FieldPreviewList" ItemsSource="{Binding FieldPreview}" Background="Transparent"
                                 BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False"
                                 AutomationProperties.Name="Значения выбранного поля">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                                <Style Selector="SelectableTextBlock.muted">
                                    <Setter Property="Foreground" Value="#ACBED3" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:InspectorFieldPreviewRow">
                                    <SelectableTextBlock Text="{Binding Text}" Margin="{Binding Indent}" Classes.muted="{Binding IsFormat}"
                                                         FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
                <ScrollViewer x:Name="RelatedPacketsScroll" Grid.Row="3" MaxHeight="76"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False"
                              AutomationProperties.Name="Связанные пакеты">
                    <ItemsControl ItemsSource="{Binding RelatedPackets}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RelatedPacketViewModel">
                                <Button Classes="secondary" Content="{Binding Title}" Click="RelatedPacketClick" Padding="8,4" Margin="0,0,6,0" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6" IsVisible="{Binding HasPacket}">
                    <TextBlock Text="Исходный текст" FontWeight="SemiBold" FontSize="12" />
                    <TextBox Grid.Row="1" Classes="analysis-log" Text="{Binding PacketSource}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="monospace" FontSize="12" MinHeight="70" MaxHeight="120"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="#0D1726" BorderBrush="#536F8B" BorderThickness="1" Foreground="#E7EFF8" Padding="8" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
