<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EMCLDesktop.ViewModels"
             x:Class="EMCLDesktop.Views.PacketInspectorView"
             x:DataType="vm:PacketInspectorViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/CommonStyles.axaml" />
        <Style Selector="Button.source.selected">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="Border.inspector-panel">
            <Setter Property="Background" Value="#172438" />
            <Setter Property="BorderBrush" Value="#293A52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Expander.analysis-input">
            <Setter Property="Background" Value="#172438" />
            <Setter Property="BorderBrush" Value="#293A52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.analysis-input /template/ Border#ExpanderContent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Expander.analysis-input /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.analysis-log:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#172438" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="TextBox.analysis-log:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="Border.field">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.field.highlighted">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
        </Style>
        <Style Selector="TreeViewItem" x:DataType="vm:InspectorFieldViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.hex-byte">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="monospace" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.hex-byte.highlighted">
            <Setter Property="Background" Value="#214A61" />
            <Setter Property="BorderBrush" Value="#69C4E1" />
            <Setter Property="Foreground" Value="#A5E8FA" />
        </Style>
        <Style Selector="TextBlock.packet-error">
            <Setter Property="Foreground" Value="#FFB4A9" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="Анализировать текущее подключение" Classes="secondary source"
                    Classes.selected="{Binding IsLive}" Command="{Binding LiveSourceCommand}" />
            <Button Content="Анализировать текст" Classes="secondary source"
                    Classes.selected="{Binding IsText}" Command="{Binding TextSourceCommand}" />
        </StackPanel>
        <Grid Grid.Row="1" IsVisible="{Binding IsText}" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="10">
            <Expander Grid.Row="0" Grid.ColumnSpan="2" Classes="analysis-input" Header="Текст для анализа"
                      IsExpanded="{Binding IsInputExpanded, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
                <TextBox Classes="analysis-log" Text="{Binding InputText, Mode=TwoWay}" Margin="0" Padding="10"
                         Background="#0D1726" BorderBrush="#536F8B" BorderThickness="1" CornerRadius="0" Foreground="#E7EFF8"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         AcceptsReturn="True" MinHeight="90" MaxHeight="140" FontFamily="monospace"
                         TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="Вставьте лог с HDLC / Wrapper / DLMS APDU. Допустимы TX/RX, время и посторонний текст." />
            </Expander>
            <TextBlock Grid.Row="1" Classes="muted" FontSize="12" VerticalAlignment="Center"
                       Text="Разбор выполняется локально. Текст и выбранный пакет сохраняются при смене режима." />
            <Button Grid.Row="1" Grid.Column="1" Content="Разобрать" Classes="primary" Command="{Binding AnalyzeTextCommand}" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding AnalysisStatus}" Classes="muted" FontSize="12" />
        <Grid Grid.Row="3" ColumnDefinitions="0.9*,Auto,1.5*" ColumnSpacing="8">
            <Border Grid.Column="0" Classes="inspector-panel">
                <Grid RowDefinitions="Auto,2*,Auto,3*" RowSpacing="8">
                    <TextBlock Text="Пакеты" Classes="section-title" FontSize="16" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Packets}" SelectedItem="{Binding SelectedPacket, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" MinHeight="80"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PacketItemViewModel">
                                <StackPanel Spacing="3" Margin="2,4">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"
                                               Classes.packet-error="{Binding HasError}" />
                                    <TextBlock Text="{Binding Details}" Classes="muted" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Структура пакета" Classes="section-title" FontSize="16" />
                    <TreeView x:Name="InspectorFieldsTree" Grid.Row="3" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                              Background="Transparent" BorderThickness="0" MinHeight="100"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:InspectorFieldViewModel" ItemsSource="{Binding Children}">
                                <Border Classes="field" Classes.highlighted="{Binding IsHighlighted}"
                                        PointerEntered="FieldPointerEntered" PointerExited="FieldPointerExited">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" />
                                </Border>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" Background="#293A52" />
            <Border Grid.Column="2" Classes="inspector-panel">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding PacketTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PacketOrigin}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding BytePageText}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="secondary" Content="←" Command="{Binding PreviousBytePageCommand}" IsEnabled="{Binding CanPreviousPage}"
                                ToolTip.Tip="Предыдущие 256 байт" Padding="10,4" />
                        <Button Grid.Column="2" Classes="secondary" Content="→" Command="{Binding NextBytePageCommand}" IsEnabled="{Binding CanNextPage}"
                                ToolTip.Tip="Следующие 256 байт" Padding="10,4" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ByteRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InspectorByteRow">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Offset}" FontFamily="monospace" FontSize="12" Foreground="#ACBED3"
                                                   VerticalAlignment="Center" Width="52" />
                                        <ItemsControl ItemsSource="{Binding Bytes}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InspectorByteViewModel">
                                                    <Button Content="{Binding Hex}" Classes="hex-byte" Classes.highlighted="{Binding IsHighlighted}"
                                                            ToolTip.Tip="{Binding Description}" AutomationProperties.Name="{Binding Description}"
                                                            PointerEntered="BytePointerEntered" PointerExited="BytePointerExited"
                                                            GotFocus="ByteGotFocus" LostFocus="ByteLostFocus" Click="ByteClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasPacket}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding FieldName}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="{Binding FieldRanges}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="К байтам поля" Command="{Binding ShowFieldBytesCommand}"
                                VerticalAlignment="Center" Padding="8,4" FontSize="11" />
                    </Grid>
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding RelatedPackets}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RelatedPacketViewModel">
                                <Button Classes="secondary" Content="{Binding Title}" Click="RelatedPacketClick" Padding="8,4" Margin="0,0,6,0" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="5" RowDefinitions="Auto,Auto" RowSpacing="6" IsVisible="{Binding HasPacket}">
                        <TextBlock Text="Исходный текст" FontWeight="SemiBold" FontSize="12" />
                        <TextBox Grid.Row="1" Classes="analysis-log" Text="{Binding PacketSource}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" FontFamily="monospace" FontSize="12" MinHeight="70" MaxHeight="120"
                                 Background="#0D1726" BorderBrush="#536F8B" BorderThickness="1" Foreground="#E7EFF8" Padding="8" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
